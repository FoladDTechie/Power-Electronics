	)
	(text "KEY VALUES (see README for derivations and sources)"
		(exclude_from_sim no)
		(at 12.7 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1b12dd6c-5fd0-5286-b0fe-32b293bcba35")
	)
	(text "Divider k = R2/(R1+R2) = 10k/210k = 1/21. Vin = 21 x V(ADC_DIV). 30 V -> 1.4286 V."
		(exclude_from_sim no)
		(at 12.7 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "83c87245-9e6d-5467-b13e-5b64b3f66d07")
	)
	(text "Use ESP32-S3 ADC1, ATTEN2 (6 dB): calibrated range 0-1600 mV, total error +/-10 mV (= +/-0.21 V at Vin)."
		(exclude_from_sim no)
		(at 12.7 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e116a9b9-af4a-5bb2-8df6-9dafd1bc96bc")
	)
	(text "Measurable up to 33.6 V (1600 mV x 21). Do not use ADC2 (shared with Wi-Fi)."
		(exclude_from_sim no)
		(at 12.7 125.72999999999999 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0401937e-12c1-5d4b-926a-e02f4707fa8d")
	)
	(text "Rth = R1||R2 = 9.52k. C1 = 100 nF (Espressif suggestion). tau = 0.95 ms, fc = 167 Hz, 12-bit settle 8.6 ms."
		(exclude_from_sim no)
		(at 12.7 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1ac8f3a2-8c2f-59a5-9296-921f11ec00cd")
	)
	(text "Worst-case ratio error: 1% parts +/-1.9% (+/-2.8% with 100 ppm/K, 0-70 C); 0.1% parts +/-0.19% (+/-0.41%)."
		(exclude_from_sim no)
		(at 12.7 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "eca3a895-a740-5552-adb3-8709c83b4180")
	)
	(text "D1 BAT54S clamps ADC_DIV to -VF..3V3+VF. VF max 240 mV @ 0.1 mA, 320 mV @ 1 mA. ESP32-S3 VIH max = VDD+0.3 V."
		(exclude_from_sim no)
		(at 12.7 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea00ac61-e7ca-5aa2-865c-e6addad92136")
	)
	(text "Worst fault (R2 open): clamp current = (Vin - ~3.55 V)/200k = 0.13 mA at 30 V. It flows INTO the 3V3 rail."
		(exclude_from_sim no)
		(at 12.7 140.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2d91f9ad-bc3f-54c4-9cae-e5103b5e0e54")
	)
	(text "Variant B: drive SENSE_EN high, wait >= 12 ms (ngspice: 10.5 ms to 0.2 mV at 30 V), sample, drive low. Off drain <= 0.2 uA (datasheet max, 25 C)."
		(exclude_from_sim no)
		(at 12.7 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ecd4b5c5-d82c-5aff-9b00-56d36d32e165")
	)
	(text "Q1 |VGS| = 0.82 x Vin, clamped by D2 to 11.4-12.7 V (BSS84 VGS max 20 V). Switch needs Vin >= ~3 V."
		(exclude_from_sim no)
		(at 12.7 148.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "060aff7a-02d0-57c6-bbaf-4aeb0720d39b")
	)
	(text "Variant A (always-on): fit R7 (0R), omit Q1, Q2, D2, R4, R5, R6. Drain = Vin/210k (143 uA at 30 V)."
