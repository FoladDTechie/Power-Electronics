		(uuid "0abe8bef-88c5-551b-9aa7-409562877d42")
	)
	(text "WARNING: Reference design. Test first with a current-limited supply and protection. Not for unattended use."
		(exclude_from_sim no)
		(at 12.7 31.75 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "33e188eb-c9e7-5ae7-8574-c017c7d04f62")
	)
	(text "Design only, not fabricated, not bench-tested."
		(exclude_from_sim no)
		(at 12.7 35.56 0)
		(effects
