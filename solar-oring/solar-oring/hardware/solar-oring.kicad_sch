	(text "Ideal diode: LTC4412 holds VIN - VSENSE at VFR = 10-32 mV until Q1 is fully on; then drop = I x RDS(on)."
		(exclude_from_sim no)
		(at 12.7 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "757a1746-0f1f-5ebb-8954-99d632ad11d6")
	)
	(text "Q1 SiS443DN: RDS(on) <= 16 mOhm at VGS = -4.5 V. LTC4412 gate clamp 6.3-7.7 V (VIN >= 6.3 V). 3 A -> <= 48 mV, <= 0.14 W."
		(exclude_from_sim no)
		(at 12.7 135.89000000000001 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "31c662c4-2f26-5376-a682-5653fc27502c")
	)
	(text "D1 SS34: VF <= 0.5 V at 3 A, 25 C -> <= 1.5 W at 3 A, about 82 K rise (55 C/W). IR <= 0.5 mA (25 C), 20 mA (100 C)."
		(exclude_from_sim no)
		(at 12.7 139.70000000000002 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "18eb9a9e-820f-51f1-9330-214185fb3f01")
	)
	(text "Solar input: LTC4412 VIN operating 2.5-28 V, abs max 36 V. Panel Voc must stay <= 22 V. D2 SMAJ24A: VR 24 V, VC 38.9 V @ 10.3 A (> 36 V!)."
		(exclude_from_sim no)
		(at 12.7 143.51000000000002 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b236e3ce-26a8-5e03-b0b6-dd19a3035d53")
	)
	(text "STAT sinks 6-17 uA when the solar path is off (VLOAD > SOLAR_IN + 10..32 mV). R1 470k -> high >= 2.8 V, low <= 0.5 V at 3.3 V."
		(exclude_from_sim no)
		(at 12.7 147.32000000000002 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "63c0da3f-4e70-5e42-8342-69d47fea2fe3")
	)
	(text "CTL high (>= 0.9 V) forces Q1 off (e.g. to read panel Voc). R2 keeps it low if the header is open."
		(exclude_from_sim no)
		(at 12.7 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2f502902-2147-5ac7-b89a-f9cef3c4204b")
	)
	(text "C3: LTC4412 suggests 1-47 uF on the load; electrolytic ESR damps the MLCC hot-plug ringing the datasheet warns about."
		(exclude_from_sim no)
		(at 12.7 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3b5dc8ed-bbd3-5d60-ae91-0abcf4109a54")
	)
